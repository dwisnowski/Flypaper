# OpenSky OAuth2 client credentials (from account page / credentials.json)
# Optional for local/dev. Hosted users enter credentials in the app UI
# (browser localStorage). Keep these here so local runs need no UI paste.
OPEN_SKY_CLIENT_ID=your-client-id-api-client
OPEN_SKY_CLIENT_SECRET=your-client-secret

# Optional: load credentials from a JSON file instead of the vars above
# OPEN_SKY_CREDENTIALS_FILE=credentials.json

# Fallback "home" location when browser geolocation is denied
HOME_LAT=37.7749
HOME_LON=-122.4194

# Default scan radius in kilometers (bbox sized to prefer 1-credit tier)
DEFAULT_RADIUS_KM=150

# API / CORS
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
# Dev: Vite origin. On Render the SPA is same-origin (optional: add https://….onrender.com).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenSky endpoints (override only if needed)
OPEN_SKY_API_BASE=https://opensky-network.org/api
OPEN_SKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# Local aircraft metadata cache (optional; `make aircraft-db`)
AIRCRAFT_DB_PATH=backend/data/aircraftDatabase.csv
AIRCRAFT_DB_URL=https://opensky-network.org/datasets/metadata/aircraftDatabase.csv
DOWNLOAD_AIRCRAFT_DB=false
